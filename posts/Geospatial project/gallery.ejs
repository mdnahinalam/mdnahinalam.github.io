<style>
.grid-gallery {
  columns: 5 200px;
  column-gap: 0.5rem;
  width: 90%;
  margin: 0 auto;
}

.grid-item {
  display: inline-block;
  width: 100%;
  border-radius: 5px;
  margin-bottom: 0.5rem;
}

img.grid-item {
  width: 100%;
  transition: all .25s ease-in-out;
}

img.grid-item:hover {
  transform: scale(1.025);
}
</style>

<div class="grid-gallery">

<% for (const item of items) { %>

<img src="<%= item.path %>"
     class="grid-item lightbox"
     loading="lazy">

<% } %>

</div>